SERVER_PORT=8080
# Railway injeta PORT automaticamente; localmente use SERVER_PORT ou PORT
DATABASE_URL=postgres://reinoplus:reinoplus@localhost:5432/reinoplus?sslmode=disable
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
# Opcional em produção (Railway): conteúdo PEM multilinha para chaves estáveis entre deploys
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
CORS_ALLOWED_ORIGINS=*
